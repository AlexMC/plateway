# Local staging only (compose.local.yml): throwaway values for a MinIO on loopback. Nothing here is a secret, and
# none of it is valid anywhere else.
PLATEWAY_IMAGE_TAG=staging
PLATEWAY_PUBLIC_ORIGIN=http://127.0.0.1:8890
CLOUDFLARE_TUNNEL_TOKEN=unused-locally

R2_ENDPOINT=http://minio.localhost:9900
PLATEWAY_LIBRARY_URL=http://minio.localhost:9900/plateway-library

MINIO_ROOT_USER=plateway-local-root
MINIO_ROOT_PASSWORD=plateway-local-root-password
API_R2_ACCESS_KEY_ID=plateway-local-api
API_R2_SECRET_ACCESS_KEY=plateway-local-api-secret
WORKER_R2_ACCESS_KEY_ID=plateway-local-worker
WORKER_R2_SECRET_ACCESS_KEY=plateway-local-worker-secret
LITESTREAM_R2_ACCESS_KEY_ID=plateway-local-litestream
LITESTREAM_R2_SECRET_ACCESS_KEY=plateway-local-litestream-secret

# compose.local.yml sets PLATEWAY_MAILER=file, so these only satisfy compose.yml's required variables.
CLOUDFLARE_EMAIL_TOKEN=unused-locally
CLOUDFLARE_ACCOUNT_ID=unused-locally
PLATEWAY_MAIL_FROM=accounts@plateway.localhost
