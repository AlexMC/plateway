# /opt/plateway/.env on the Plateway server: written from 1Password at deploy time (docs/operations.md, "Secrets"),
# mode 0600, never committed. Every value below is a placeholder.

# The image tag `docker compose build` produces and every Plateway container runs (the deployed git commit).
PLATEWAY_IMAGE_TAG=0000000

# The public origin Cloudflare serves; host and origin checks, cookies and email links come from it.
PLATEWAY_PUBLIC_ORIGIN=https://plateway.alexcarvalho.me

# Cloudflare Tunnel (1Password: "Plateway Cloudflare Tunnel", field credential).
CLOUDFLARE_TUNNEL_TOKEN=placeholder-tunnel-token

# R2: the account's S3 endpoint, and the public URL of plateway-library (its custom domain). The worker reads
# community pieces from that URL, so it needs no token for the library.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
PLATEWAY_LIBRARY_URL=https://plateway-library.alexcarvalho.me

# One R2 token per container, each scoped to its own buckets (1Password: "Plateway R2 api|worker|litestream").
# api: plateway-packages and plateway-library, Object Read & Write.
API_R2_ACCESS_KEY_ID=placeholder
API_R2_SECRET_ACCESS_KEY=placeholder
# worker: plateway-packages, Object Read & Write.
WORKER_R2_ACCESS_KEY_ID=placeholder
WORKER_R2_SECRET_ACCESS_KEY=placeholder
# litestream: plateway-backups, Object Read & Write.
LITESTREAM_R2_ACCESS_KEY_ID=placeholder
LITESTREAM_R2_SECRET_ACCESS_KEY=placeholder

# Cloudflare Email Sending: an account API token with the Email Sending send permission (1Password: "Plateway
# Cloudflare Email", field credential) and the account id ("Plateway Config", field account_id). The sender's domain
# is onboarded in Email Sending, which adds its bounce MX, SPF, DKIM and DMARC records.
CLOUDFLARE_EMAIL_TOKEN=placeholder
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
PLATEWAY_MAIL_FROM=accounts@mail.plateway.alexcarvalho.me

# The library bot's GitHub App (1Password: "Plateway GitHub App", fields app_id and credential: the private key as
# base64 on one line) and the library repository, owner/name (AlexMC/plateway-library). Set all three, or leave all
# three empty until the App exists.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
PLATEWAY_GITHUB_REPO=
